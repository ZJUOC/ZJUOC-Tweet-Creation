MCP_BEARER_TOKEN=generate-a-long-random-token
# Must match the public Host header, including a non-standard port when used.
MCP_PUBLIC_BASE_URL=https://wechat-mcp.example.com
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_ALLOW_PUBLISH=false
MCP_STATE_PATH=/data/state.db

# Single-account configuration. For multiple accounts, use
# WECHAT_ACCOUNTS_JSON as documented in README.md.
WECHAT_ACCOUNT_ALIAS=primary
WECHAT_ACCOUNT_NAME=My Official Account
WECHAT_ACCOUNT_TYPE=subscription
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret
