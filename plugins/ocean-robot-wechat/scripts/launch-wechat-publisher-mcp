#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVER_ROOT="$PLUGIN_ROOT/mcp/wechat-publisher-mcp"

if [[ -f "$PLUGIN_ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$PLUGIN_ROOT/.env"
  set +a
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required: https://docs.astral.sh/uv/" >&2
  exit 2
fi

if [[ -z "${MCP_BEARER_TOKEN:-}" || -z "${WECHAT_APP_ID:-}" || -z "${WECHAT_APP_SECRET:-}" ]]; then
  echo "Missing MCP_BEARER_TOKEN, WECHAT_APP_ID, or WECHAT_APP_SECRET." >&2
  echo "Set them in a private shell environment; never paste them into an article or chat." >&2
  exit 2
fi

cd "$SERVER_ROOT"
exec uv run wechat-publisher-mcp
